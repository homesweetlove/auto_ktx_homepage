# 서버 바인딩 주소와 포트. HOST 기본값은 127.0.0.1(로컬 전용)입니다.
# 127.0.0.1 / localhost / ::1 이외의 주소로 바인딩하면 ADMIN_TOKEN이 필수입니다.
HOST=127.0.0.1
PORT=3000

# API 접근용 관리자 토큰. 설정하면 모든 /api 요청(/api/health 제외)에 필요합니다.
# 예: openssl rand -hex 32
ADMIN_TOKEN=

# 리버스 프록시 뒤에서 실행할 때 (요청 제한이 실제 클라이언트 IP 기준으로 동작하도록)
# TRUST_PROXY=1

# (선택) 코레일 계정. 설정하면 대시보드에서 로그인하지 않아도 감시를 시작할 수 있습니다.
KORAIL_ID=
KORAIL_PASSWORD=
